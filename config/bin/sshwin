#!/usr/bin/env bash
# sshwin — open a new Ghostty window and run ssh inside it
#
# Usage: sshwin [--no-tmux] [-s SESSION | --session SESSION] [ssh args...]
#
# Flags:
#   --no-tmux          skip the remote tmux command and -t flag
#   -s, --session      remote tmux session to attach to / create (default: main)
#                      also accepts --session=NAME
#
# Environment:
#   SSHWIN_SESSION     default session name when -s is not given (default: main)
#   SSHWIN_REMOTE_CMD  override the whole remote command; takes precedence over -s

set -euo pipefail

use_tmux=1
session="${SSHWIN_SESSION:-main}"
declare -a ssh_args=()

usage() {
  printf 'Usage: sshwin [--no-tmux] [-s SESSION] [ssh args...]\n' >&2
  exit "${1:-1}"
}

while (($# > 0)); do
  case "$1" in
    --no-tmux)
      use_tmux=0
      ;;
    -s|--session)
      # ssh has no -s of its own that takes a name here, so this is safe.
      [[ $# -ge 2 ]] || { printf 'sshwin: %s needs a session name\n' "$1" >&2; usage; }
      session="$2"
      shift
      ;;
    --session=*)
      session="${1#--session=}"
      ;;
    --)
      # Everything after -- is for ssh verbatim.
      shift
      ssh_args+=("$@")
      break
      ;;
    *)
      ssh_args+=("$1")
      ;;
  esac
  shift
done

if [[ -z "$session" ]]; then
  printf 'sshwin: session name must not be empty\n' >&2
  exit 1
fi

if ((${#ssh_args[@]} == 0)); then
  usage
fi

ssh_bin="$(command -v ssh)"

declare -a cmd=("$ssh_bin")

if ((use_tmux)); then
  cmd+=("-t")
fi

cmd+=("${ssh_args[@]}")

if ((use_tmux)); then
  # The remote command is one string parsed by the remote shell, so the
  # session name is quoted for it. -A makes "new" attach to an existing
  # session of that name instead of failing, so this creates or resumes.
  if [[ -n "${SSHWIN_REMOTE_CMD:-}" ]]; then
    cmd+=("$SSHWIN_REMOTE_CMD")
  else
    session_q="$(python3 -c 'import shlex,sys; print(shlex.quote(sys.argv[1]))' "$session")"
    cmd+=("tmux -u new -A -s $session_q")
  fi
fi

quoted="$(python3 -c 'import shlex,sys; print(shlex.join(sys.argv[1:]))' "${cmd[@]}")"

# Ghostty runs the configured command as: bash -c "exec -l <command>". That
# means the command must be a bare executable — a string starting with a shell
# builtin (export) or containing ";" gets mangled, and Ghostty also inserts
# "--" between a command and its args. A tiny self-contained script sidesteps
# all of it.
tmp="$(mktemp "${TMPDIR:-/tmp}/sshwin.XXXXXX")"
printf '#!/bin/sh\nexport TERM=tmux-256color\nexec %s\n' "$quoted" > "$tmp"
chmod +x "$tmp"

# Drive Ghostty through its AppleScript API so the window opens in the RUNNING
# instance. The alternatives are both wrong on macOS:
#   open -na           starts a second copy of the app, with its own Dock icon
#   open -a <script>   prompts "Allow Ghostty to execute…" and opens a tab
osascript - "$tmp" <<'APPLESCRIPT'
on run argv
  tell application "Ghostty"
    set cfg to new surface configuration
    set command of cfg to (item 1 of argv)
    new window with configuration cfg
  end tell
end run
APPLESCRIPT

# Clean up once Ghostty has had time to start the script.
(sleep 5 && rm -f "$tmp") &
disown
