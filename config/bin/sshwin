#!/usr/bin/env bash
# sshwin — open a new Ghostty window and run ssh inside it
#
# Usage: sshwin [--no-tmux] [ssh args...]
#
# Flags:
#   --no-tmux          skip the remote tmux command and -t flag
#
# Environment:
#   SSHWIN_REMOTE_CMD  override the default remote command (default: tmux -u new -A -s main)

set -euo pipefail

use_tmux=1
declare -a ssh_args=()

for arg in "$@"; do
  if [[ "$arg" == "--no-tmux" ]]; then
    use_tmux=0
  else
    ssh_args+=("$arg")
  fi
done

if ((${#ssh_args[@]} == 0)); then
  printf 'Usage: sshwin [--no-tmux] [ssh args...]\n' >&2
  exit 1
fi

ssh_bin="$(command -v ssh)"

declare -a cmd=("$ssh_bin")

if ((use_tmux)); then
  cmd+=("-t")
fi

cmd+=("${ssh_args[@]}")

if ((use_tmux)); then
  cmd+=("${SSHWIN_REMOTE_CMD:-tmux -u new -A -s main}")
fi

quoted="$(python3 -c 'import shlex,sys; print(shlex.join(sys.argv[1:]))' -- "${cmd[@]}")"

# Ghostty runs the configured command as: bash -c "exec -l <command>". That
# means the command must be a bare executable — a string starting with a shell
# builtin (export) or containing ";" gets mangled, and Ghostty also inserts
# "--" between a command and its args. A tiny self-contained script sidesteps
# all of it.
tmp="$(mktemp "${TMPDIR:-/tmp}/sshwin.XXXXXX")"
printf '#!/bin/sh\nexport TERM=tmux-256color\nexec %s\n' "$quoted" > "$tmp"
chmod +x "$tmp"

# Drive Ghostty through its AppleScript API so the window opens in the RUNNING
# instance. The alternatives are both wrong on macOS:
#   open -na           starts a second copy of the app, with its own Dock icon
#   open -a <script>   prompts "Allow Ghostty to execute…" and opens a tab
osascript - "$tmp" <<'APPLESCRIPT'
on run argv
  tell application "Ghostty"
    set cfg to new surface configuration
    set command of cfg to (item 1 of argv)
    new window with configuration cfg
  end tell
end run
APPLESCRIPT

# Clean up once Ghostty has had time to start the script.
(sleep 5 && rm -f "$tmp") &
disown
