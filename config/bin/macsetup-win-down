#!/bin/sh
# Windows-style Win+Down for the frontmost window:
#   fullscreen  -> leave fullscreen
#   maximized/snapped by Rectangle -> restore previous size
#   anything else -> minimize (like Windows)
# Invoked by Karabiner (Win+Down). Needs Accessibility for the invoking
# process tree (karabiner_console_user_server), same as the Win+D rule had.

exec osascript <<'EOF'
tell application "System Events"
    set p to first application process whose frontmost is true
    if (count of windows of p) is 0 then return
    set w to front window of p
    try
        if value of attribute "AXFullScreen" of w is true then
            set value of attribute "AXFullScreen" of w to false
            return
        end if
    end try
    set pos1 to position of w
    set size1 to size of w
end tell

-- Try Rectangle's restore; it only does something for windows Rectangle resized.
do shell script "open -g 'rectangle://execute-action?name=restore'"
delay 0.3

tell application "System Events"
    set p to first application process whose frontmost is true
    if (count of windows of p) is 0 then return
    set w to front window of p
    if (position of w is equal to pos1) and (size of w is equal to size1) then
        -- Nothing to restore: minimize, like Windows does.
        set value of attribute "AXMinimized" of w to true
    end if
end tell
EOF
