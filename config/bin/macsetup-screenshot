#!/usr/bin/env python3
"""Copy a screenshot of the display the cursor is on to the clipboard.

macOS's own whole-screen shortcut (Cmd+Ctrl+Shift+3) only ever copies the
MAIN display, so on a multi-display setup it silently grabs the wrong screen.
screencapture can target a specific display, but only by its 1-based index in
the active display list — which this resolves from the cursor's position.

Usage: macsetup-screenshot [--region]
  (no args)  whole current display -> clipboard   (Win+PrintScreen)
  --region   interactive region    -> clipboard   (PrintScreen)
"""

import ctypes
import ctypes.util
import subprocess
import sys

cg = ctypes.CDLL(ctypes.util.find_library("ApplicationServices"))


class CGPoint(ctypes.Structure):
    _fields_ = [("x", ctypes.c_double), ("y", ctypes.c_double)]


class CGSize(ctypes.Structure):
    _fields_ = [("w", ctypes.c_double), ("h", ctypes.c_double)]


class CGRect(ctypes.Structure):
    _fields_ = [("origin", CGPoint), ("size", CGSize)]


cg.CGEventCreate.restype = ctypes.c_void_p
cg.CGEventCreate.argtypes = [ctypes.c_void_p]
cg.CGEventGetLocation.restype = CGPoint
cg.CGEventGetLocation.argtypes = [ctypes.c_void_p]
cg.CGGetActiveDisplayList.argtypes = [ctypes.c_uint32,
                                      ctypes.POINTER(ctypes.c_uint32),
                                      ctypes.POINTER(ctypes.c_uint32)]
cg.CGDisplayBounds.restype = CGRect
cg.CGDisplayBounds.argtypes = [ctypes.c_uint32]


def display_index_under_cursor(default=1):
    """1-based index for `screencapture -D`, or the default if not found."""
    event = cg.CGEventCreate(None)
    if not event:
        return default
    point = cg.CGEventGetLocation(event)
    ids = (ctypes.c_uint32 * 16)()
    count = ctypes.c_uint32()
    if cg.CGGetActiveDisplayList(16, ids, ctypes.byref(count)) != 0:
        return default
    for i in range(count.value):
        b = cg.CGDisplayBounds(ids[i])
        if (b.origin.x <= point.x < b.origin.x + b.size.w
                and b.origin.y <= point.y < b.origin.y + b.size.h):
            return i + 1
    return default


def main():
    if "--region" in sys.argv:
        # -i interactive selection, -c clipboard; display-independent.
        return subprocess.run(["screencapture", "-i", "-c"]).returncode
    return subprocess.run(
        ["screencapture", "-x", "-c", "-D", str(display_index_under_cursor())]
    ).returncode


if __name__ == "__main__":
    sys.exit(main())
